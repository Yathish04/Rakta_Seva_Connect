<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hospital Registration"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etHospitalName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Hospital Name (e.g., Taluka General)"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etHospitalPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Emergency Contact Number"
        android:inputType="phone"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnRegisterHospital"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register &amp; Open Dashboard"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="24dp"/>

    <Button
        android:id="@+id/btnGetLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get Current Location"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvLocationDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location: Not Set"
        android:textStyle="italic"
        android:layout_marginBottom="16dp"/>

</LinearLayout>